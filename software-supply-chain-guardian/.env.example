# Copy to .env if you want to change defaults. No secrets are required.
SSC_BACKEND_URL=http://127.0.0.1:8000
SSC_MAX_UPLOAD_BYTES=5242880
SSC_MAX_UPLOAD_FILES=10
SSC_GIT_TIMEOUT_SECONDS=90
SSC_MAX_REPO_FILES=60
SSC_MAX_REPO_FILE_BYTES=5242880
SSC_DB_PATH=data/analyses.db
SSC_MAX_STORED_ANALYSES=200
# Known-vulnerability lookup against OSV.dev (sends package names + versions only). No API key needed.
SSC_VULN_SCAN=true
SSC_OSV_URL=https://api.osv.dev
SSC_VULN_TIMEOUT_SECONDS=45
# Syft is OFF by default. Enable only if you have installed Syft and accept scanning local images.
SSC_ENABLE_SYFT=false
